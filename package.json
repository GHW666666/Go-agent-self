{
  "name": "goagent",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "relay": "go -C relay run .",
    "host": "pnpm --filter goagent-host start",
    "web": "pnpm --filter goagent-web dev",
    "build": "pnpm --filter goagent-web build",
    "smoke": "node scripts/smoke-m1.mjs",
    "smoke:m2": "node scripts/smoke-m2.mjs",
    "test": "go -C relay test -count=5 ."
  }
}
